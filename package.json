{
  "name": "domeneshop-mcp",
  "version": "2.0.6",
  "description": "MCP server exposing the Domeneshop API — manage domains, DNS records, HTTP forwards, dynamic DNS and invoices from an AI assistant.",
  "mcpName": "io.github.martinzachariassen/domeneshop-mcp",
  "type": "module",
  "bin": {
    "domeneshop-mcp": "dist/index.js"
  },
  "exports": {},
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#domeneshop/*": "./src/domeneshop/*",
    "#mcp/*": "./src/mcp/*",
    "#testing/*": "./test/support/*"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "spec:check": "node scripts/openapi.mjs --check",
    "spec:update": "node scripts/openapi.mjs --update && biome format --write test/contract/domeneshop-openapi.json",
    "banner:build": "node scripts/build-banner.mjs",
    "banner:check": "node scripts/build-banner.mjs --check",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-version.mjs && biome format --write server.json mcpb/manifest.json",
    "mcpb:build": "node scripts/build-mcpb.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "domeneshop",
    "dns",
    "domains",
    "claude"
  ],
  "author": "Martin Zachariassen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzachariassen/domeneshop-mcp.git"
  },
  "homepage": "https://github.com/martinzachariassen/domeneshop-mcp#readme",
  "bugs": {
    "url": "https://github.com/martinzachariassen/domeneshop-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
